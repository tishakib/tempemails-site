{
  "cleanUrls": true,
  "functions": {
    "index.js": {
      "includeFiles": "{*.html,*.xml,*.txt,assets/**,blog/**,data_store.json}"
    }
  },
  "redirects": [
    {
      "source": "/blog-article.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog-article",
      "destination": "/blog",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin-shakib",
      "destination": "/admin-shakib.html"
    }
  ]
}
